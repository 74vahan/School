# Copy to terraform.tfvars (git-ignored) and fill in real values.

project_id         = "your-gcp-project-id"
region              = "europe-west1"
zone                = "europe-west1-b"
environment         = "prod"
ssh_pub_key_path    = "~/.ssh/school_site_deploy.pub"
allowed_ssh_ranges  = ["203.0.113.0/24"] # restrict to your admin IP range, not 0.0.0.0/0
