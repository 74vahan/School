# Copy to .env (git-ignored). Real secrets are injected by the CI/CD deploy step,
# never committed here.

APP_IMAGE=ghcr.io/your-org/school-site-backend
APP_IMAGE_TAG=latest

FRONTEND_IMAGE=ghcr.io/your-org/school-site-frontend
FRONTEND_IMAGE_TAG=latest

DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=school-site.example.com
DEFAULT_LANGUAGE=ru

DB_USER=school_site
DB_PASSWORD=change-me
DB_NAME=school_site
